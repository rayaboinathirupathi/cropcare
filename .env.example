# ==============================================================================
# CropCare AI — Environment Configuration Template
# Copy this file to .env.local for local development.
# ==============================================================================

# 1. Multimodal AI Provider (Google Gemini)
# Get your API key from Google AI Studio: https://aistudio.google.com
# If not provided, the application automatically uses the verified agricultural
# offline knowledge and symptom-matching fallback engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Supabase Configuration (Optional - PostgreSQL, Auth & Image Storage)
# If not set, CropCare AI operates in resilient local storage / demo session mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 3. Weather & Location Services
# Default: open-meteo (Free, high-accuracy, no API key required for non-commercial)
WEATHER_PROVIDER=open-meteo

# 4. Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# 5. Administrative Controls
# Used to authorize knowledge repository management and review farmer feedback.
ADMIN_SECRET_KEY=cropcare_admin_secret_dev_2026
